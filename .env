# ==========================================================
# Environment Variables — Selenium MCP Server (v2025.10.20b)
# ==========================================================

# Toggles between macOS (local) and Render sandbox
LOCAL_MODE=false

# Chrome binaries (Render vs Local)
CHROME_BINARY=/opt/render/project/src/.local/chrome/chrome-linux/chrome
CHROMEDRIVER_PATH=./chromedriver/chromedriver
CHROME_VERSION=120.0.6099.18

LOCAL_CHROME_BINARY=/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
LOCAL_CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# MCP Server metadata
SERVER_NAME=Selenium
SERVER_DESC="MCP server providing headless browser automation via Selenium."

# Execution and runtime toggles
RUN_VALIDATION=false
RUN_DIAGNOSTICS=true

# Port and Python settings
PORT=10000
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Logging verbosity
LOG_LEVEL=info
